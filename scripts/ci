#!/bin/bash
set -e

# Builds the SwiftPM Example app. The package itself is built and tested by
# _spm-build.yml / _test.yml against .swiftpm/xcode/package.xcworkspace;
# this covers the Example app that consumes the package, which is the closest
# thing the repo has to a real consumer integration.

source "$(dirname "${BASH_SOURCE[0]}")/ios-ci-config"

SPM_EXAMPLE_WORKSPACE="Example/Backpack-SPM.xcworkspace"
SPM_EXAMPLE_SCHEME=${SPM_EXAMPLE_SCHEME:-'Backpack Native'}
SWIFT=${SWIFT:-'5.0'}
BUILD_SDK=${BUILD_SDK:-'iphonesimulator'}
DESTINATION=${DESTINATION:-$BPK_SIMULATOR_DESTINATION}

function buildSpmExample() {
    echo "Building SPM Example app ($SPM_EXAMPLE_SCHEME)"

    xcodebuild build \
        -workspace $SPM_EXAMPLE_WORKSPACE \
        -scheme "$SPM_EXAMPLE_SCHEME" \
        SWIFT_VERSION=$SWIFT \
        -sdk $BUILD_SDK \
        -destination "$DESTINATION" \
        ONLY_ACTIVE_ARCH=YES 2>&1
}

buildSpmExample
