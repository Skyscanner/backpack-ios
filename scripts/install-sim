#!/bin/bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/ios-ci-config"

device_name=${SIM_DEVICE_NAME:-$BPK_SIMULATOR_NAME}
device_type=${SIM_DEVICE_TYPE:-$BPK_SIMULATOR_TYPE}
runtime=${SIM_RUNTIME:-com.apple.CoreSimulator.SimRuntime.iOS-${BPK_IOS_VERSION//./-}}

if ! xcrun simctl list runtimes available --json |
    jq -e --arg runtime "$runtime" '.runtimes | any(.identifier == $runtime)' > /dev/null; then
    version=${runtime#com.apple.CoreSimulator.SimRuntime.iOS-}
    xcodebuild -downloadPlatform iOS -buildVersion "${version//-/.}" >&2
fi

device_id=$(xcrun simctl list devices available --json |
    jq -r --arg runtime "$runtime" --arg name "$device_name" --arg type "$device_type" '
        first(.devices[$runtime][]? | select(.name == $name and .deviceTypeIdentifier == $type) | .udid) // empty
    ')

if [[ -z "$device_id" ]]; then
    device_id=$(xcrun simctl create "$device_name" "$device_type" "$runtime")
fi

printf '%s\n' "$device_id"
